      "move":  { "fps": 12, "loop": true },
      "sleep": { "fps": 6,  "loop": true },
      "eat":   { "fps": 10, "loop": false },
      "drink": { "fps": 10, "loop": false },
      "play":  { "fps": 12, "loop": false },
      "clean": { "fps": 10, "loop": false },
      "train": { "fps": 12, "loop": false }
    }
  },
  "spritesheetPath": "spritesheet.webp",
  "frameWidth": 192,
  "frameHeight": 208,
  "columns": 8,
  "rows": 9,
