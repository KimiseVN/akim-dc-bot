    "jump":      { "row": 4, "frames": 5, "durationMs": 840,  "iterations": 2 },
    "eat":       { "row": 5, "frames": 8, "durationMs": 1220, "iterations": 1 },
    "drink":     { "row": 5, "frames": 8, "durationMs": 1220, "iterations": 1 },
    "play":      { "row": 5, "frames": 8, "durationMs": 1100, "iterations": 2 },
    "sad":       { "row": 5, "frames": 8, "durationMs": 1220, "iterations": 2 },
    "sleep":     { "row": 6, "frames": 6, "durationMs": 1010, "iterations": "infinite" },
    "train":     { "row": 8, "frames": 6, "durationMs": 1030, "iterations": 2 },
    "sick":      { "row": 8, "frames": 6, "durationMs": 1030, "iterations": "infinite" }
  }
