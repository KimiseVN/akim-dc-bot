# Discord
DISCORD_TOKEN=your_bot_token_here
DISCORD_APP_ID=your_application_id_here

# Optional: comma-separated guild IDs to sync commands instantly while developing.
# Leave empty in production to sync globally (takes up to 1 hour to propagate).
DEV_GUILD_IDS=

# Private-bot mode. When set to a comma-separated list of guild IDs, the
# bot will only operate in those servers:
#   • On startup, any guild not on the list is auto-left.
#   • Any new invite to an off-list guild is auto-declined (bot leaves
#     immediately on on_guild_join).
#   • Slash commands are synced per-guild to just these ones (skip the
#     slow ~1h global sync) — unless DEV_GUILD_IDS is also set, which
#     wins for sync targeting.
# Leave EMPTY to accept every guild (legacy behavior) — that way an
# accidentally-blank env var won't strand the bot by leaving everything.
ALLOWED_GUILD_IDS=

# Database
# Railway PostgreSQL exposes DATABASE_URL automatically.
# For local dev with SQLite use: sqlite+aiosqlite:///./bot.db
DATABASE_URL=sqlite+aiosqlite:///./bot.db

# Bot refuses to start in a detected production environment (Railway/Fly/
# Render/Kubernetes) when DATABASE_URL is missing or points at SQLite,
# because SQLite inside a container is wiped on every redeploy. Set this
# to "true" to bypass the guard (e.g. you intentionally mounted a volume).
# ALLOW_SQLITE_IN_PROD=true

# Pet system (Phase 2) — filesystem base for pet asset images.
# On Railway: create a Volume in the service's Volumes tab, mount it at
# /data, then set PET_STORAGE_PATH=/data/pets here.
# On local dev: point at any directory on disk, e.g. ./data/pets
PET_STORAGE_PATH=./data/pets

# === akim-desk-pet API ======================================================
# Enable the FastAPI endpoints + /link-desktop slash command by setting a
# strong random DESKTOP_TOKEN_SECRET. Leave empty to disable.
# Recommended generator: python -c "import secrets; print(secrets.token_urlsafe(48))"
DESKTOP_TOKEN_SECRET=
# Required for the HTTP confirm endpoint. The /link-desktop slash command
# bypasses HTTP (same-process call), so dev-only deploys can leave this blank.
DISCORD_BOT_API_SECRET=
# Bind host + port. On Railway set PORT in service variables instead.
DESK_API_HOST=0.0.0.0
DESK_API_PORT=8080
# Comma-separated origins for CORS. Leave at * during MVP; tighten before
# shipping installer to users.
DESK_API_CORS_ORIGINS=*
# Link-code lifetime (minutes) and issued JWT lifetime (days).
LINK_CODE_EXPIRE_MINUTES=10
DESKTOP_TOKEN_EXPIRE_DAYS=30
